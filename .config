# ImmortalWrt v24.10.6 x86_64, 1G rootfs
# QModem stable v3.3.0 + legacy Lua UI
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_IMAGES_GZIP=y

# daed: eBPF/BTF runtime requirements
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

# ccache for repeatable CI builds
CONFIG_CCACHE=y

# LuCI base collection (minimal UI), argon as default theme
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# Requested applications
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# QModem stable v3.3.0 (legacy Lua UI + SMS plugin)
CONFIG_PACKAGE_qmodem=y
# CONFIG_PACKAGE_qmodem_INCLUDE_SEAL is not set
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-i18n-qmodem-zh-cn=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-i18n-qmodem-sms-zh-cn=y
CONFIG_PACKAGE_sms-forwarder=y
# CONFIG_PACKAGE_sms-forwarder-next is not set
CONFIG_PACKAGE_sms-tool_q=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_tom_modem_EARLY_RETURN=y
CONFIG_PACKAGE_tom_modem_ENABLE_UBUS_DAEMON=y
# Next UI is intentionally not installed (two main UIs must not coexist)
# CONFIG_PACKAGE_luci-app-qmodem-next is not set
# CONFIG_PACKAGE_luci-app-qmodem-monitor is not set
# CONFIG_PACKAGE_luci-app-qmodem-mwan is not set
# CONFIG_PACKAGE_luci-app-qmodem-ttl is not set
# CONFIG_PACKAGE_luci-app-qmodem-ttlfw4 is not set
# CONFIG_PACKAGE_luci-app-qmodem-uplink is not set
# CONFIG_PACKAGE_luci-app-qmodem-voip is not set

# USB Quectel 5G: vendor QMI driver + Tom customized Quectel CM
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ndisc6=y
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_rdisc6 is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_no_ndisc_rdisc6 is not set
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_vendor-qmi-wwan=y
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_generic-qmi-wwan is not set
CONFIG_PACKAGE_luci-app-qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
# CONFIG_PACKAGE_luci-app-qmodem_USING_QWRT_QUECTEL_CM_5G is not set
# CONFIG_PACKAGE_luci-app-qmodem_USING_NORMAL_QUECTEL_CM is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ADD_PCI_SUPPORT is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ADD_QFIREHOSE_SUPPORT is not set

# Removed: lm-sensors upstream patch fails under GNU make; autocore depends on it
# CONFIG_PACKAGE_autocore is not set
# CONFIG_PACKAGE_lm-sensors is not set
# CONFIG_PACKAGE_libsensors is not set

# Explicitly off: replaced by daed
# CONFIG_PACKAGE_luci-app-openclash is not set
